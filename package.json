{
  "name": "personal-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "charts": "node render-charts.js && node build.js",
    "export": "node export.js",
    "watch": "DEV=1 node --watch-path=./posts build.js",
