{
  "name": "personal-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "charts": "node render-charts.mjs && node build.js",
    "watch": "node --watch-path=./posts build.js",
    "dev": "trap 'kill 0' EXIT; node --watch-path=./posts build.js & node render-charts.mjs --watch & python3 -m http.server 7000"
  },
  "devDependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "katex": "^0.17.0",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0"
  }
}
